# ============================================================
# Intima — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ============================================================
# 核心配置
# ============================================================
# Set to 'true' to skip OAuth/payment gateways (local dev).
# Set to 'false' for production.
DEV_MODE=true

# Flask environment: development | production
FLASK_ENV=development

# Application environment: development | staging | production
ENV=development

# Site URL (no trailing slash)
SITE_URL=http://localhost:5000

# Application version (semver)
APP_VERSION=2.0.0

# Security keys — change in production!
# Generate: python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=change-me-to-a-random-secret
IDCARD_KEY=change-me-to-another-random-key

# ============================================================
# MongoDB Atlas
# ============================================================
# Format: mongodb+srv://user:pass@cluster.mongodb.net/bibi?retryWrites=true&w=majority
# Register: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bibi?retryWrites=true&w=majority

# ============================================================
# Upstash Redis
# ============================================================
# Format: rediss://:token@host.upstash.io:port
# Register: https://upstash.com
REDIS_URL=rediss://:token@host.upstash.io:6379

# Celery (uses Upstash Redis)
CELERY_BROKER_URL=rediss://:token@host.upstash.io:6379/0
CELERY_RESULT_BACKEND=rediss://:token@host.upstash.io:6379/0

# ============================================================
# Mail (SMTP)
# ============================================================
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
DEFAULT_MAIL_SENDER=

# Admin email for system notifications
ADMIN_EMAIL=season@maybi.cn

# ============================================================
# OAuth — Authlib (Google + Facebook only)
# ============================================================
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# OAuth redirect base URL (change to actual domain in production)
OAUTH_REDIRECT_BASE=http://localhost:5000

# ============================================================
# Payment — Adult Three-Channel (CCBill / EcomCharge / WcPay)
# ============================================================
# CCBill (US/CA/GB, ~10.8-14.5%) — https://ccbill.com
CCBILL_ACCOUNT_ID=
CCBILL_API_KEY=

# EcomCharge (EU, 3.5-5%) — https://ecomcharge.com
ECOMCHARGE_API_KEY=

# WcPay (Global fallback, USDC settlement) — https://wcpay.io
WCPAY_API_KEY=

# Sandbox mode (default: true)
PAYMENT_SANDBOX=true

# ============================================================
# Monitoring (Sentry)
# ============================================================
# Sentry DSN — https://sentry.io (free tier: 5,000 errors/month)
# Leave empty to disable.
SENTRY_DSN=

# ============================================================
# Deployment (Render)
# ============================================================
# Render reads render.yaml automatically on push.
# Set these in Render Dashboard → Environment Variables:
#   - All keys marked sync: false in render.yaml
# https://render.com/docs/blueprint-spec
